CIS_LLM_API_KEY=Bearer sk-ddj4Fx7zrJh6ENxSYaYQVw
CIS_LLM_MODEL=hack-fest-gpt-5.6-luna
ENABLE_LLM=true
ENABLE_VISION=true
CONFIDENCE_THRESHOLD=85
RAG_TOP_K=8
MAX_LLM_ROWS=0
MAX_IMAGES_PER_ITEM=0
# Read EVERY matched image individually with CIS Vision.
VISION_READ_EACH_IMAGE=true
# 0 = send every image again in the final multimodal classification call.
# For lower latency/cost, set 6 or 0 and rely on the per-image vision evidence.
FINAL_VISION_IMAGES=0
OCR_LANG=eng
ENABLE_PADDLE_OCR=true
ENABLE_EASYOCR=true
ENABLE_CRAFT=true
# Optional: path to a deployment-specific DBNet++ ONNX model.
DBNETPP_MODEL_PATH=

# Preserve supplied sample-output decisions for exact matching records.
REFERENCE_VALIDATION_OVERLAY=true
